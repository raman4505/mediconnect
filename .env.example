# Optional MySQL connection. The app never falls back to demo mode automatically.
MEDICONNECT_DB_URL=jdbc:mysql://localhost:3306/mediconnect?useSSL=false&serverTimezone=UTC
MEDICONNECT_DB_USER=mediconnect
MEDICONNECT_DB_PASSWORD=change-me

# Choose exactly one app mode: demo (in-memory) or mysql (persistent).
MEDICONNECT_MODE=demo

# Optional one-time initial administrator bootstrap for a fresh MySQL database.
# Leave unset after the initial admin has been created.
MEDICONNECT_INITIAL_ADMIN_NAME=
MEDICONNECT_INITIAL_ADMIN_EMAIL=
MEDICONNECT_INITIAL_ADMIN_PASSWORD=
